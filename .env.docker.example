# Copy this file to .env before creating the Synology Container Manager project.
# Change both passwords. Do not commit the real .env file.

APP_PORT=18080
APP_TIMEZONE=Asia/Jakarta

DB_NAME=ujian_online
DB_USER=ujian_app
DB_PASSWORD=GANTI_PASSWORD_APLIKASI_YANG_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_YANG_BERBEDA

# Use the NAS LAN address. Example: http://192.168.18.47:18080
PUBLIC_BASE_URL=http://NAS-IP:18080
